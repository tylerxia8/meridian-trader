{
  "name": "meridian-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Binary stock outcome markets on Solana — MAG7 0DTE prediction markets",
  "license": "MIT",
  "workspaces": [
    "app",
    "automation"
  ],
  "scripts": {
    "build:program": "anchor build",
    "test:program": "anchor test",
    "test:program:skip-deploy": "anchor test --skip-deploy",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "lifecycle:demo": "tsx scripts/lifecycle.ts",
    "create:markets": "tsx scripts/create-markets.ts",
    "settle:markets": "tsx scripts/settle-markets.ts",
    "dev:app": "npm run dev --workspace=app",
    "dev:automation": "npm run dev --workspace=automation",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^1.0.2",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.11.0",
    "chai": "^4.3.0",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
