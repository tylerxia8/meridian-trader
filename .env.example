# Solana cluster: devnet | localnet | mainnet-beta (never use mainnet for core submission)
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Helius RPC (optional, higher rate limits) — get key at helius.dev
# HELIUS_API_KEY=
# SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Path to the Solana keypair the program is deployed with / automation signs with
ANCHOR_WALLET=./keypairs/admin.json
AUTOMATION_WALLET=./keypairs/automation.json

# Program ID (filled in after first `anchor build && anchor deploy`)
MERIDIAN_PROGRAM_ID=

# USDC mint on devnet (devnet USDC faucet mint, not real USDC)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Pyth regular-hours US equity feed IDs (Hermes/Core, 0x-prefixed)
PYTH_FEED_AAPL=0x49f6b65cb1de6b10eaf75e7c03ca029c306d0357e91b5311b175084a5ad55688
PYTH_FEED_MSFT=0xd0ca23c1cc005e004ccf1db5bf76aeb6a49218f43dac3d4b275e92de12ded4d1
PYTH_FEED_GOOGL=0x5a48c03e9b9cb337801073ed9d166817473697efff0d138874e0f6a33d6d5aa6
PYTH_FEED_AMZN=0xb5d0e0fa58a1f8b81498ae670ce93c872d14434b72c364885d4fa1b257cbb07a
PYTH_FEED_NVDA=0xb1073854ed24cbc755dc527418f52b7d271f6cc967bbf8d8129112b18860a593
PYTH_FEED_META=0x78a3e3b8e676a8f73c439f5d749737034b139bbbe899ba5775216fba596607fe
PYTH_FEED_TSLA=0x16dad506d7db8da01c87581c87ca897a012a153557d4d578c3b9c9e1bc0632f1
PYTH_HERMES_URL=https://hermes.pyth.network

# Oracle freshness threshold (seconds) — reject prices older than this at settlement
ORACLE_MAX_STALENESS_SECS=300

# Oracle confidence threshold — reject if confidence band > this fraction of price (e.g., 0.005 = 0.5%)
ORACLE_MAX_CONF_RATIO=0.005

# Strike configuration
STRIKE_PERCENTAGES=3,6,9
STRIKE_ROUND_TO=10

# Automation schedule (US Eastern Time)
MORNING_JOB_CRON=0 8 * * 1-5
# Safety guard for manual runs. Keep false in normal operation so the morning
# job cannot create a second live-price strike set after the 9:30am ET open.
MORNING_ALLOW_AFTER_OPEN=false
SETTLEMENT_JOB_CRON=5 16 * * 1-5
SETTLEMENT_MAX_RETRIES=30
SETTLEMENT_RETRY_DELAY_MS=30000

# Admin override settlement: delay (seconds) after market close before override allowed
ADMIN_OVERRIDE_DELAY_SECS=3600
# Opt-in only. Uses admin_settle after the on-chain delay if the oracle settlement path fails.
SETTLEMENT_ADMIN_FALLBACK=false

# Lifecycle smoke demo defaults. The demo can create and settle a short-lived
# market without Phoenix. It only exercises mint_pair/redeem_pair if the admin
# wallet already has at least 1.00 demo USDC in its associated token account.
LIFECYCLE_DEMO_TICKER=META
LIFECYCLE_DEMO_STRIKE_CENTS=68000
LIFECYCLE_DEMO_SETTLEMENT_CENTS=69000
LIFECYCLE_DEMO_EXPIRY_SECS=20
LIFECYCLE_ADMIN_OVERRIDE_DELAY_SECS=1
LIFECYCLE_MAX_WAIT_SECS=120

# Experimental Phoenix market creation defaults. These create a Yes/USDC book
# with 1 cent ticks and a 0.01 Yes base lot.
PHOENIX_BIDS_SIZE=512
PHOENIX_ASKS_SIZE=512
PHOENIX_NUM_SEATS=128
PHOENIX_QUOTE_LOTS_PER_QUOTE_UNIT=10000
PHOENIX_BASE_LOTS_PER_BASE_UNIT=100
PHOENIX_TICK_SIZE_IN_QUOTE_LOTS_PER_BASE_UNIT=100
PHOENIX_TAKER_FEE_BPS=0
PHOENIX_SMOKE_USDC_UNITS=1
PHOENIX_SMOKE_ASK_PRICE=0.60
PHOENIX_SMOKE_SIZE_BASE_UNITS=0.01

# Frontend
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_MERIDIAN_PROGRAM_ID=
