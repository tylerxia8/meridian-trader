# Solana cluster: devnet | localnet | mainnet-beta (never use mainnet for core submission)
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Helius RPC (optional, higher rate limits) — get key at helius.dev
# HELIUS_API_KEY=
# SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Path to the Solana keypair the program is deployed with / automation signs with
ANCHOR_WALLET=./keypairs/admin.json
AUTOMATION_WALLET=./keypairs/automation.json

# Program ID (filled in after first `anchor build && anchor deploy`)
MERIDIAN_PROGRAM_ID=

# USDC mint on devnet (devnet USDC faucet mint, not real USDC)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Pyth price feed accounts (devnet) — replace with actual feed IDs for each ticker
PYTH_FEED_AAPL=
PYTH_FEED_MSFT=
PYTH_FEED_GOOGL=
PYTH_FEED_AMZN=
PYTH_FEED_NVDA=
PYTH_FEED_META=
PYTH_FEED_TSLA=

# Oracle freshness threshold (seconds) — reject prices older than this at settlement
ORACLE_MAX_STALENESS_SECS=300

# Oracle confidence threshold — reject if confidence band > this fraction of price (e.g., 0.005 = 0.5%)
ORACLE_MAX_CONF_RATIO=0.005

# Strike configuration
STRIKE_PERCENTAGES=3,6,9
STRIKE_ROUND_TO=10

# Automation schedule (US Eastern Time)
MORNING_JOB_CRON=0 8 * * 1-5
SETTLEMENT_JOB_CRON=5 16 * * 1-5

# Admin override settlement: delay (seconds) after market close before override allowed
ADMIN_OVERRIDE_DELAY_SECS=3600

# Frontend
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_MERIDIAN_PROGRAM_ID=
